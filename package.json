{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:hotel": "node --experimental-strip-types --test tests/*.test.mts",
    "check": "npm run lint && npm run typecheck && npm run test:hotel && npm run db:verify-migrations && npm run build -- --webpack",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "admin:grant": "node scripts/grant-platform-admin.mjs",
    "partner:grant": "node scripts/grant-hotel-partner.mjs",
    "db:generate": "prisma generate",
    "db:verify-migrations": "node scripts/verify-migrations.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:backup": "node scripts/backup-database.mjs",
    "release:verify-env": "node scripts/verify-release-env.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
