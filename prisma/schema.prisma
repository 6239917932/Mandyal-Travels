generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                          String                         @id @default(cuid())
  email                       String                         @unique
  passwordHash                String
  firstName                   String
  lastName                    String
  role                        String                         @default("CUSTOMER")
  accessStatus                String                         @default("ACTIVE")
  accessVersion               Int                            @default(0)
  accessChangedAt             DateTime?
  emailVerifiedAt             DateTime?
  marketingConsentAt          DateTime?
  bookingEmailEnabled         Boolean                        @default(true)
  smsAlertsEnabled            Boolean                        @default(false)
  whatsappAlertsEnabled       Boolean                        @default(false)
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  sessions                    UserSession[]
  securityEvents              AccountSecurityEvent[]
  trips                       CustomerTrip[]
  organizationMemberships     OrganizationMember[]
  businessTravelRequests      BusinessTravelRequest[]        @relation("BusinessTravelRequester")
  reviewedTravelRequests      BusinessTravelRequest[]        @relation("BusinessTravelReviewer")
  businessAuditEntries        BusinessAuditLog[]             @relation("BusinessAuditActor")
  businessSupportCases        BusinessSupportCase[]          @relation("BusinessSupportCaseCreator")
  customerSupportCases        CustomerSupportCase[]          @relation("CustomerSupportCaseCreator")
  reviewedCustomerCases       CustomerSupportCase[]          @relation("CustomerSupportCaseReviewer")
  customerSupportEvents       CustomerSupportCaseEvent[]     @relation("CustomerSupportCaseEventActor")
  sentBusinessInvitations     OrganizationInvitation[]       @relation("BusinessInvitationSender")
  acceptedInvitations         OrganizationInvitation[]       @relation("BusinessInvitationAcceptor")
  createdPolicyVersions       OrganizationPolicyVersion[]    @relation("OrganizationPolicyVersionCreator")
  supplyPartnerMemberships    SupplyPartnerMember[]
  partnerAuditEntries         PartnerAuditLog[]              @relation("PartnerAuditActor")
  partnerApplications         PartnerApplication[]           @relation("PartnerApplicationApplicant")
  reviewedPartnerApplications PartnerApplication[]           @relation("PartnerApplicationReviewer")
  hotelReviews                HotelReview[]                  @relation("HotelReviewAuthor")
  moderatedHotelReviews       HotelReview[]                  @relation("HotelReviewModerator")
  analyticsEvents             AnalyticsEvent[]
  notificationDeliveries      NotificationDelivery[]
  passwordResetTokens         PasswordResetToken[]
  mfaCredential               UserMfaCredential?
  mfaRecoveryCodes            UserMfaRecoveryCode[]
  consentRecords              UserConsentRecord[]
  privacyRequests             DataPrivacyRequest[]
  reviewedPrivacyRequests     DataPrivacyRequest[]           @relation("PrivacyRequestReviewer")
  privacyRequestEvents        DataPrivacyRequestEvent[]      @relation("PrivacyRequestEventActor")
  updatedPlatformFeatureFlags PlatformFeatureFlag[]          @relation("PlatformFeatureFlagUpdater")
  platformFeatureFlagEvents   PlatformFeatureFlagEvent[]     @relation("PlatformFeatureFlagEventActor")
  createdDestinationContent   DestinationContent[]           @relation("DestinationContentCreator")
  updatedDestinationContent   DestinationContent[]           @relation("DestinationContentUpdater")
  destinationContentEvents    DestinationContentEvent[]      @relation("DestinationContentEventActor")
  promotionCampaignEvents     PromotionCampaignEvent[]       @relation("PromotionCampaignEventActor")
  partnerSettlementEvents     PartnerSettlementEvent[]       @relation("PartnerSettlementEventActor")
  integrationOutboxReviews    IntegrationOutboxReviewEvent[] @relation("IntegrationOutboxReviewActor")
  searchProjectionRebuilds    SearchProjectionRebuildEvent[] @relation("SearchProjectionRebuildActor")
  accessEvents                UserAccessEvent[]              @relation("UserAccessSubject")
  performedAccessEvents       UserAccessEvent[]              @relation("UserAccessActor")

  @@index([role, accessStatus])
}

model UserAccessEvent {
  id          String   @id @default(cuid())
  userId      String
  actorUserId String
  action      String
  fromStatus  String
  toStatus    String
  reason      String
  version     Int
  createdAt   DateTime @default(now())
  user        User     @relation("UserAccessSubject", fields: [userId], references: [id], onDelete: Restrict)
  actor       User     @relation("UserAccessActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([userId, version])
  @@index([userId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
}

model UserConsentRecord {
  id            String    @id @default(cuid())
  userId        String
  purpose       String
  policyVersion String
  status        String
  source        String    @default("ACCOUNT")
  recordedAt    DateTime  @default(now())
  withdrawnAt   DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, recordedAt])
  @@index([purpose, status, recordedAt])
}

model DataPrivacyRequest {
  id               String                    @id @default(cuid())
  userId           String
  reviewedByUserId String?
  requestType      String
  status           String                    @default("OPEN")
  version          Int                       @default(1)
  requestedAt      DateTime                  @default(now())
  dueAt            DateTime
  completedAt      DateTime?
  resolutionNote   String                    @default("")
  user             User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy       User?                     @relation("PrivacyRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  events           DataPrivacyRequestEvent[]

  @@index([userId, requestType, requestedAt])
  @@index([status, dueAt])
  @@index([reviewedByUserId])
}

model DataPrivacyRequestEvent {
  id          String             @id @default(cuid())
  requestId   String
  actorUserId String
  action      String
  fromStatus  String
  toStatus    String
  note        String
  version     Int
  createdAt   DateTime           @default(now())
  request     DataPrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor       User               @relation("PrivacyRequestEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([actorUserId, createdAt])
}

model UserMfaCredential {
  id               String                @id @default(cuid())
  userId           String                @unique
  secretCiphertext String
  enabledAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes    UserMfaRecoveryCode[]
}

model UserMfaRecoveryCode {
  id           String            @id @default(cuid())
  userId       String
  credentialId String
  codeHash     String
  usedAt       DateTime?
  createdAt    DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential   UserMfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([credentialId, usedAt])
}

model SupplyPartner {
  id                    String                      @id @default(cuid())
  name                  String
  type                  String                      @default("HOTEL")
  status                String                      @default("ACTIVE")
  contactEmail          String?
  contactPhone          String?
  commissionBasisPoints Int                         @default(1000)
  settlementDelayDays   Int                         @default(2)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  members               SupplyPartnerMember[]
  properties            PartnerProperty[]
  auditEntries          PartnerAuditLog[]
  applications          PartnerApplication[]
  vehicles              PartnerVehicle[]
  vehicleReservations   PartnerVehicleReservation[]
  busRoutes             PartnerBusRoute[]
  busReservations       PartnerBusReservation[]
  channelConnections    HotelChannelConnection[]
  settlements           PartnerSettlement[]
  settlementLines       PartnerSettlementLine[]
  paymentAllocations    PaymentAllocation[]
  payoutAccounts        PartnerPayoutAccount[]
  payoutInstructions    PartnerPayoutInstruction[]
  flightConnections     FlightSupplierConnection[]

  @@index([status, createdAt])
}

model SupplyPartnerMember {
  id        String        @id @default(cuid())
  partnerId String
  userId    String        @unique
  role      String        @default("ADMIN")
  createdAt DateTime      @default(now())
  partner   SupplyPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partnerId, userId])
  @@index([partnerId, role])
}

model PartnerProperty {
  id                  String                        @id @default(cuid())
  partnerId           String
  hotelSlug           String                        @unique
  displayName         String
  propertyType        String                        @default("HOTEL")
  contactEmail        String                        @default("")
  contactPhone        String                        @default("")
  timezone            String                        @default("Asia/Kolkata")
  status              String                        @default("ACTIVE")
  listingSource       String                        @default("ASSIGNED")
  publicationStatus   String                        @default("PUBLISHED")
  approvalStatus      String                        @default("PENDING_REVIEW")
  approvalNote        String                        @default("")
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewedByUserId    String?
  description         String                        @default("")
  locality            String                        @default("")
  tehsil              String                        @default("")
  district            String                        @default("")
  locationAliasesJson String                        @default("[]")
  city                String                        @default("")
  state               String                        @default("")
  country             String                        @default("India")
  streetAddress       String                        @default("")
  postalCode          String                        @default("")
  latitude            Float                         @default(0)
  longitude           Float                         @default(0)
  starRating          Int                           @default(3)
  checkInTime         String                        @default("14:00")
  checkOutTime        String                        @default("11:00")
  amenitiesJson       String                        @default("[]")
  policiesJson        String                        @default("[]")
  languagesJson       String                        @default("[]")
  landmarksJson       String                        @default("[]")
  imageUrlsJson       String                        @default("[]")
  minimumCheckInAge   Int                           @default(18)
  childrenAllowed     Boolean                       @default(true)
  petsAllowed         Boolean                       @default(false)
  smokingAllowed      Boolean                       @default(false)
  imageUrl            String                        @default("https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1600&q=80")
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  partner             SupplyPartner                 @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  inventoryDays       PartnerHotelInventoryDay[]
  physicalRooms       PartnerPhysicalRoom[]
  rooms               PartnerRoomType[]
  channelMappings     HotelChannelPropertyMapping[]

  @@index([partnerId, status])
  @@index([listingSource, publicationStatus, status])
  @@index([approvalStatus, submittedAt])
}

model FlightSupplierConnection {
  id               String                    @id @default(cuid())
  partnerId        String
  providerCode     String
  displayName      String
  environment      String                    @default("SANDBOX")
  credentialRef    String
  status           String                    @default("DRAFT")
  lastHealthStatus String                    @default("NOT_TESTED")
  lastHealthAt     DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  partner          SupplyPartner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  operations       FlightSupplierOperation[]

  @@unique([partnerId, providerCode, environment])
  @@index([partnerId, status, updatedAt])
}

model FlightSupplierOperation {
  id            String                   @id @default(cuid())
  connectionId  String
  operationType String
  correlationId String
  requestHash   String
  status        String                   @default("QUEUED")
  providerRef   String                   @default("")
  attempts      Int                      @default(0)
  nextAttemptAt DateTime                 @default(now())
  lastError     String                   @default("")
  completedAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  connection    FlightSupplierConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, correlationId])
  @@index([status, nextAttemptAt, createdAt])
  @@index([connectionId, createdAt])
}

model PartnerBusRoute {
  id            String           @id @default(cuid())
  partnerId     String
  code          String           @unique
  origin        String
  destination   String
  boardingPoint String
  droppingPoint String
  status        String           @default("ACTIVE")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  partner       SupplyPartner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  trips         PartnerBusTrip[]

  @@index([partnerId, status])
  @@index([origin, destination, status])
}

model PartnerBusTrip {
  id                 String                  @id @default(cuid())
  routeId            String
  serviceDate        String
  departureTime      String
  arrivalTime        String
  busType            String
  seatCapacity       Int
  pricePerSeat       Int
  currency           String                  @default("INR")
  amenitiesJson      String                  @default("[]")
  cancellationPolicy String
  refundable         Boolean                 @default(false)
  status             String                  @default("ACTIVE")
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  route              PartnerBusRoute         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  reservations       PartnerBusReservation[]

  @@unique([routeId, serviceDate, departureTime])
  @@index([serviceDate, status])
}

model PartnerBusReservation {
  id               String         @id @default(cuid())
  confirmationCode String         @unique
  partnerId        String
  tripId           String
  customerTripId   String         @unique
  customerName     String
  customerEmail    String
  seatNumbersJson  String
  passengerCount   Int
  totalAmount      Int
  currency         String         @default("INR")
  status           String         @default("CONFIRMED")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  partner          SupplyPartner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  trip             PartnerBusTrip @relation(fields: [tripId], references: [id], onDelete: Restrict)
  customerTrip     CustomerTrip   @relation(fields: [customerTripId], references: [id], onDelete: Cascade)

  @@index([tripId, status])
  @@index([partnerId, status, createdAt])
}

model PartnerRoomType {
  id                      String                @id @default(cuid())
  propertyId              String
  roomTypeId              String                @unique
  name                    String
  description             String
  bedDescription          String
  inventoryCount          Int
  maximumAdults           Int
  maximumChildren         Int
  maximumGuests           Int
  nightlyRate             Int
  taxesAndFees            Int
  ratePlanName            String
  mealPlan                String                @default("room-only")
  refundable              Boolean               @default(true)
  cancellationDescription String
  amenitiesJson           String                @default("[]")
  imageUrl                String                @default("https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=1200&q=80")
  status                  String                @default("ACTIVE")
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  property                PartnerProperty       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  physicalRooms           PartnerPhysicalRoom[]
  ratePlans               PartnerRatePlan[]

  @@index([propertyId, status])
}

model PartnerApplication {
  id                String         @id @default(cuid())
  applicantUserId   String
  reviewedByUserId  String?
  partnerId         String?
  businessName      String
  partnerType       String
  contactName       String
  contactEmail      String
  contactPhone      String
  city              String
  inventorySummary  String
  legalBusinessName String         @default("")
  registeredAddress String         @default("")
  taxIdentifier     String         @default("")
  registrationId    String         @default("")
  identityType      String         @default("")
  identityReference String         @default("")
  kycStatus         String         @default("SUBMITTED")
  kycConsentAt      DateTime?
  status            String         @default("PENDING")
  reviewNote        String?
  reviewedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  applicant         User           @relation("PartnerApplicationApplicant", fields: [applicantUserId], references: [id], onDelete: Cascade)
  reviewedBy        User?          @relation("PartnerApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  partner           SupplyPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([applicantUserId, createdAt])
  @@index([kycStatus, createdAt])
}

model PartnerHotelInventoryDay {
  id                String          @id @default(cuid())
  propertyId        String
  roomTypeId        String
  stayDate          String
  availableRooms    Int
  nightlyRate       Int?
  minimumStayNights Int?
  maximumStayNights Int?
  closedToArrival   Boolean         @default(false)
  closedToDeparture Boolean         @default(false)
  currency          String          @default("INR")
  stopSell          Boolean         @default(false)
  note              String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  property          PartnerProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, roomTypeId, stayDate])
  @@index([propertyId, stayDate])
}

model PartnerVehicle {
  id                 String                       @id @default(cuid())
  partnerId          String
  code               String                       @unique
  vehicleName        String
  category           String
  registrationNumber String?
  registrationExpiry String                       @default("")
  insuranceExpiry    String                       @default("")
  permitExpiry       String                       @default("")
  fitnessExpiry      String                       @default("")
  pollutionExpiry    String                       @default("")
  transmission       String
  seats              Int
  bags               Int
  fuelPolicy         String
  mileagePolicy      String
  cancellationPolicy String
  featuresJson       String                       @default("[]")
  pickupLocation     String
  dropoffLocation    String
  pricePerDay        Int
  currency           String                       @default("INR")
  totalUnits         Int                          @default(1)
  status             String                       @default("ACTIVE")
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  partner            SupplyPartner                @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  inventoryDays      PartnerVehicleInventoryDay[]
  maintenanceRecords PartnerVehicleMaintenance[]
  reservations       PartnerVehicleReservation[]

  @@index([partnerId, status])
  @@index([pickupLocation, dropoffLocation, status])
}

model PartnerVehicleInventoryDay {
  id             String         @id @default(cuid())
  vehicleId      String
  serviceDate    String
  availableUnits Int
  pricePerDay    Int?
  stopSell       Boolean        @default(false)
  note           String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  vehicle        PartnerVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, serviceDate])
  @@index([vehicleId, serviceDate])
}

model PartnerVehicleReservation {
  id               String         @id @default(cuid())
  confirmationCode String         @unique
  partnerId        String
  vehicleId        String
  customerTripId   String         @unique
  customerName     String
  customerEmail    String
  pickupDate       String
  dropoffDate      String
  units            Int            @default(1)
  totalAmount      Int
  currency         String         @default("INR")
  status           String         @default("CONFIRMED")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  partner          SupplyPartner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  vehicle          PartnerVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customerTrip     CustomerTrip   @relation(fields: [customerTripId], references: [id], onDelete: Cascade)

  @@index([partnerId, status, createdAt])
  @@index([vehicleId, pickupDate, dropoffDate, status])
}

model PartnerAuditLog {
  id           String        @id @default(cuid())
  partnerId    String
  actorUserId  String?
  action       String
  entityType   String
  entityId     String?
  summary      String
  metadataJson String        @default("{}")
  createdAt    DateTime      @default(now())
  partner      SupplyPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  actor        User?         @relation("PartnerAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([partnerId, createdAt])
  @@index([partnerId, action, createdAt])
}

model AccountSecurityEvent {
  id        String   @id @default(cuid())
  userId    String
  action    String
  summary   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Organization {
  id                String                      @id @default(cuid())
  name              String
  type              String
  contactEmail      String?
  contactPhone      String?
  legalName         String?
  billingAddress    String?
  taxRegistrationId String?
  approvalRequired  Boolean                     @default(true)
  defaultCabinClass String                      @default("ECONOMY")
  maximumTripAmount Int?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  members           OrganizationMember[]
  travelRequests    BusinessTravelRequest[]
  auditEntries      BusinessAuditLog[]
  invitations       OrganizationInvitation[]
  policyVersions    OrganizationPolicyVersion[]
  supportCases      BusinessSupportCase[]
  agencyCustomers   AgencyCustomer[]
}

model AgencyCustomer {
  id             String                        @id @default(cuid())
  organizationId String
  displayName    String
  email          String
  phone          String                        @default("")
  notes          String                        @default("")
  status         String                        @default("ACTIVE")
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  travelRequests AgencyCustomerTravelRequest[]

  @@unique([organizationId, email])
  @@index([organizationId, status, createdAt])
}

model AgencyCustomerTravelRequest {
  businessTravelRequestId String                @id
  agencyCustomerId        String
  createdAt               DateTime              @default(now())
  businessTravelRequest   BusinessTravelRequest @relation(fields: [businessTravelRequestId], references: [id], onDelete: Cascade)
  agencyCustomer          AgencyCustomer        @relation(fields: [agencyCustomerId], references: [id], onDelete: Cascade)

  @@index([agencyCustomerId, createdAt])
}

model BusinessSupportCase {
  id               String       @id @default(cuid())
  caseNumber       String       @unique
  organizationId   String
  createdByUserId  String
  category         String
  subject          String
  message          String
  bookingReference String?
  status           String       @default("OPEN")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User         @relation("BusinessSupportCaseCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([createdByUserId, createdAt])
}

model CustomerSupportCase {
  id               String                     @id @default(cuid())
  caseNumber       String                     @unique
  userId           String
  reviewedByUserId String?
  customerTripId   String?
  hotelBookingId   String?
  category         String
  subject          String
  message          String
  bookingReference String?
  status           String                     @default("OPEN")
  resolutionNote   String?
  closedAt         DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  createdBy        User                       @relation("CustomerSupportCaseCreator", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User?                      @relation("CustomerSupportCaseReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  customerTrip     CustomerTrip?              @relation(fields: [customerTripId], references: [id], onDelete: SetNull)
  hotelBooking     Booking?                   @relation(fields: [hotelBookingId], references: [id], onDelete: SetNull)
  events           CustomerSupportCaseEvent[]

  @@index([userId, status, createdAt])
  @@index([status, updatedAt])
  @@index([customerTripId])
  @@index([hotelBookingId])
}

model CustomerSupportCaseEvent {
  id          String              @id @default(cuid())
  caseId      String
  actorUserId String?
  action      String
  summary     String
  createdAt   DateTime            @default(now())
  supportCase CustomerSupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor       User?               @relation("CustomerSupportCaseEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([actorUserId, createdAt])
}

model OrganizationPolicyVersion {
  id                String                  @id @default(cuid())
  organizationId    String
  version           Int
  approvalRequired  Boolean
  defaultCabinClass String
  maximumTripAmount Int?
  createdByUserId   String?
  createdAt         DateTime                @default(now())
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         User?                   @relation("OrganizationPolicyVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  travelRequests    BusinessTravelRequest[]

  @@unique([organizationId, version])
  @@index([organizationId, createdAt])
}

model OrganizationInvitation {
  id               String       @id @default(cuid())
  organizationId   String
  email            String
  role             String       @default("TRAVELLER")
  tokenHash        String       @unique
  status           String       @default("PENDING")
  invitedByUserId  String
  acceptedByUserId String?
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy        User         @relation("BusinessInvitationSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy       User?        @relation("BusinessInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

