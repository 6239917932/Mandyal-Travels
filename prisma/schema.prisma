  description String
  createdAt   DateTime         @default(now())
  journal     FinancialJournal @relation(fields: [journalId], references: [id], onDelete: Restrict)

  @@index([journalId, direction])
  @@index([accountCode, createdAt])
  @@index([partnerId, accountCode, createdAt])
}

model PartnerSettlementLine {
  id                String            @id @default(cuid())
  settlementId      String
  partnerId         String
  bookingId         String?           @unique
  sourceType        String
  sourceId          String
  reference         String
  grossAmount       Int
  commissionAmount  Int
  taxWithheldAmount Int               @default(0)
  adjustmentAmount  Int               @default(0)
  netAmount         Int
  currency          String
  eligibleAt        DateTime
  createdAt         DateTime          @default(now())
  settlement        PartnerSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  partner           SupplyPartner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  booking           Booking?          @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId])
  @@index([settlementId, createdAt])
  @@index([partnerId, eligibleAt])
}

model PartnerPayoutAccount {
  id                     String                     @id @default(cuid())
  partnerId              String
  provider               String
  providerBeneficiaryRef String                     @unique
  accountHolderName      String
  bankName               String
  accountLast4           String
  routingCodeMasked      String                     @default("")
  status                 String                     @default("PENDING_VERIFICATION")
  isDefault              Boolean                    @default(false)
  verifiedAt             DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  partner                SupplyPartner              @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  payoutInstructions     PartnerPayoutInstruction[]

  @@index([partnerId, status, isDefault])
}

model PartnerPayoutBatch {
  id               String                     @id @default(cuid())
  idempotencyKey   String                     @unique
  currency         String
  totalAmount      Int
  instructionCount Int
  status           String                     @default("DRAFT")
  providerBatchRef String?                    @unique
  approvedByUserId String?
  approvedAt       DateTime?
  submittedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  instructions     PartnerPayoutInstruction[]

  @@index([status, createdAt])
}

model PartnerPayoutInstruction {
  id                String               @id @default(cuid())
  batchId           String
  settlementId      String               @unique
  payoutAccountId   String
  partnerId         String
  amount            Int
  currency          String
  status            String               @default("QUEUED")
  providerPayoutRef String?              @unique
  failureCode       String               @default("")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  batch             PartnerPayoutBatch   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  settlement        PartnerSettlement    @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  payoutAccount     PartnerPayoutAccount @relation(fields: [payoutAccountId], references: [id], onDelete: Restrict)
  partner           SupplyPartner        @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([batchId, status])
  @@index([partnerId, status, createdAt])
}

model PromotionCampaign {
  id              String                   @id @default(cuid())
  code            String                   @unique
  name            String
  description     String                   @default("")
  productsJson    String
  percentOff      Int
  maximumDiscount Int
  minimumSubtotal Int
  usageLimit      Int?
  startsAt        DateTime
  endsAt          DateTime
  active          Boolean                  @default(false)
  version         Int                      @default(1)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  events          PromotionCampaignEvent[]

  @@index([active, startsAt, endsAt])
  @@index([updatedAt])
}

model PromotionCampaignEvent {
  id          String            @id @default(cuid())
  campaignId  String
  actorUserId String
  action      String
  fromActive  Boolean
  toActive    Boolean
  reason      String
  version     Int
  createdAt   DateTime          @default(now())
  campaign    PromotionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actor       User              @relation("PromotionCampaignEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([campaignId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
}

model RoomInventoryOverride {
  id             String   @id
  roomTypeId     String
  stayDate       String
  availableRooms Int
  note           String
  updatedAt      DateTime @updatedAt

  @@unique([roomTypeId, stayDate])
  @@index([roomTypeId, stayDate])
}

model PlatformFeatureFlag {
  key             String                     @id
  enabled         Boolean
  version         Int                        @default(1)
  changeReason    String
  updatedByUserId String
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  updatedBy       User                       @relation("PlatformFeatureFlagUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  events          PlatformFeatureFlagEvent[]

  @@index([enabled, updatedAt])
}

model PlatformFeatureFlagEvent {
  id          String              @id @default(cuid())
  flagKey     String
  enabled     Boolean
  version     Int
  reason      String
  actorUserId String
  createdAt   DateTime            @default(now())
  flag        PlatformFeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)
  actor       User                @relation("PlatformFeatureFlagEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([flagKey, createdAt])
  @@index([createdAt])
}

model DestinationContent {
  id              String                    @id @default(cuid())
  slug            String                    @unique
  name            String
  state           String
  country         String                    @default("India")
  summary         String
  introduction    String
  heroImageUrl    String
  bestTimeToVisit String
  highlightsJson  String                    @default("[]")
  travelTipsJson  String                    @default("[]")
  status          String                    @default("DRAFT")
  version         Int                       @default(1)
  changeReason    String
  createdByUserId String
  updatedByUserId String
  publishedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  createdBy       User                      @relation("DestinationContentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy       User                      @relation("DestinationContentUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  events          DestinationContentEvent[]

  @@index([status, updatedAt])
  @@index([state, status, name])
}

model DestinationContentEvent {
  id            String             @id @default(cuid())
  destinationId String
  actorUserId   String
  action        String
  status        String
  version       Int
  reason        String
  createdAt     DateTime           @default(now())
  destination   DestinationContent @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  actor         User               @relation("DestinationContentEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([destinationId, createdAt])
  @@index([createdAt])
}
