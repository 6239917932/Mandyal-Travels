generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               String        @default("CUSTOMER")
  emailVerifiedAt    DateTime?
  marketingConsentAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  sessions           UserSession[]
  trips              CustomerTrip[]
}

model CustomerTrip {
  id               String   @id @default(cuid())
  userId           String?
  email            String
  productType      String
  confirmationCode String   @unique
  status           String
  title            String
  subtitle         String
  startDate        String
  endDate          String?
  totalAmount      Int
  currency         String   @default("INR")
  detailsJson      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
}

model UserSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AvailabilityLock {
  id              String   @id
  roomTypeId      String
  checkInDate     String   @default("")
  checkOutDate    String   @default("")
  quantity        Int
  inventorySource String
  status          String
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  quote            HotelQuote?
  booking          Booking?

  @@index([roomTypeId, status, expiresAt])
}

model HotelQuote {
  id                 String             @id
  hotelSlug          String             @default("")
  checkInDate        String             @default("")
  checkOutDate       String             @default("")
  ratePlanId         String             @default("")
  rooms              Int                @default(1)
  currency           String
  totalAmount        Int
  nights             Int
  quotedAt           DateTime
  expiresAt          DateTime
  availabilityLockId String             @unique
  availabilityLock   AvailabilityLock   @relation(fields: [availabilityLockId], references: [id])
  components         PriceComponent[]
  booking            Booking?
}

model PriceComponent {
  id       String     @id @default(cuid())
  quoteId  String
  type     String
  label    String
  amount   Int
  currency String
  quote    HotelQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model Booking {
  id                 String             @id
  confirmationCode   String             @unique
  idempotencyKey     String             @unique
  accessTokenHash    String?            @unique
  hotelSlug          String
  status             String
  totalAmount        Int
  currency           String
  createdAt          DateTime           @default(now())
  quoteId            String             @unique
  availabilityLockId String             @unique
  quote              HotelQuote         @relation(fields: [quoteId], references: [id])
  availabilityLock   AvailabilityLock   @relation(fields: [availabilityLockId], references: [id])
  guest              BookingGuest?
  payment            PaymentTransaction?
  amendments         BookingAmendment[]
}

model BookingAmendment {
  id                    String   @id
  bookingId             String
  requestedCheckInDate  String
  requestedCheckOutDate String
  reason                String
  status                String
  createdAt             DateTime @default(now())
  reviewedAt            DateTime?
  reviewNote            String?
  requestedTotalAmount  Int?
  booking               Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status, createdAt])
}

model BookingGuest {
  id        String  @id @default(cuid())
  bookingId String  @unique
  firstName String
  lastName  String
  email     String
  phone     String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model PaymentTransaction {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  status      String
  amount      Int
  currency    String
  provider    String
  providerRef String   @unique
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model RoomInventoryOverride {
  id             String   @id
  roomTypeId     String
  stayDate       String
  availableRooms Int
  note           String
  updatedAt      DateTime @updatedAt

  @@unique([roomTypeId, stayDate])
  @@index([roomTypeId, stayDate])
}
