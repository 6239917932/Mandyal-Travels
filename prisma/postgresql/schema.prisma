  bankName               String
  accountLast4           String
  routingCodeMasked      String                     @default("")
  status                 String                     @default("PENDING_VERIFICATION")
  isDefault              Boolean                    @default(false)
  version                Int                        @default(1)
  reviewReason           String                     @default("")
  reviewedByUserId       String?
  reviewedAt             DateTime?
  verifiedAt             DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  partner                SupplyPartner              @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  reviewedBy             User?                      @relation("PartnerPayoutAccountReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  events                 PartnerPayoutAccountEvent[]
  payoutInstructions     PartnerPayoutInstruction[]

  @@index([partnerId, status, isDefault])
}

model PartnerPayoutBatch {
  id               String                     @id @default(cuid())
  idempotencyKey   String                     @unique
  currency         String
  totalAmount      Int
  instructionCount Int
  status           String                     @default("DRAFT")
  providerBatchRef String?                    @unique
  approvedByUserId String?
  approvedAt       DateTime?
  submittedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  instructions     PartnerPayoutInstruction[]

  @@index([status, createdAt])
}

model PartnerPayoutInstruction {
  id                String               @id @default(cuid())
  batchId           String
  settlementId      String               @unique
  payoutAccountId   String
  partnerId         String
  amount            Int
  currency          String
  status            String               @default("QUEUED")
  providerPayoutRef String?              @unique
  failureCode       String               @default("")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  batch             PartnerPayoutBatch   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  settlement        PartnerSettlement    @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  payoutAccount     PartnerPayoutAccount @relation(fields: [payoutAccountId], references: [id], onDelete: Restrict)
  partner           SupplyPartner        @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([batchId, status])
  @@index([partnerId, status, createdAt])
}

model PromotionCampaign {
  id              String                   @id @default(cuid())
  code            String                   @unique
  name            String
  description     String                   @default("")
  productsJson    String
  percentOff      Int
  maximumDiscount Int
  minimumSubtotal Int
  usageLimit      Int?
  usageCount      Int                      @default(0)
  startsAt        DateTime
  endsAt          DateTime
  active          Boolean                  @default(false)
  version         Int                      @default(1)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  events          PromotionCampaignEvent[]
  redemptions     PromotionRedemption[]

  @@index([active, startsAt, endsAt])
  @@index([updatedAt])
}

model PromotionRedemption {
  id               String                 @id @default(cuid())
  campaignId       String
  userId           String?
  checkoutIntentId String?                @unique
  bookingId        String?                @unique
  customerTripId   String?                @unique
  claimKey         String                 @unique
  contextHash      String
  status           String                 @default("RESERVED")
  code             String
  productType      String
  ruleVersion      Int
  subtotal         Int
  discountAmount   Int
  finalTotal       Int
  currency         String
  expiresAt        DateTime
  createdAt        DateTime               @default(now())
  redeemedAt       DateTime?
  releasedAt       DateTime?
  reversedAt       DateTime?
  reversalReason   String                 @default("")
  campaign         PromotionCampaign      @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  user             User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  checkoutIntent   PaymentCheckoutIntent? @relation(fields: [checkoutIntentId], references: [id], onDelete: Restrict)
  booking          Booking?               @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customerTrip     CustomerTrip?          @relation(fields: [customerTripId], references: [id], onDelete: Restrict)

  @@index([campaignId, status, expiresAt])
  @@index([userId, campaignId, status])
  @@index([status, expiresAt])
}

model PromotionCampaignEvent {
  id          String            @id @default(cuid())
  campaignId  String
  actorUserId String
  action      String
  fromActive  Boolean
  toActive    Boolean
  reason      String
  version     Int
  createdAt   DateTime          @default(now())
  campaign    PromotionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actor       User              @relation("PromotionCampaignEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([campaignId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
}

model RoomInventoryOverride {
  id             String   @id
  roomTypeId     String
  stayDate       String
  availableRooms Int
  note           String
  updatedAt      DateTime @updatedAt

  @@unique([roomTypeId, stayDate])
  @@index([roomTypeId, stayDate])
}

model PlatformFeatureFlag {
  key             String                     @id
  enabled         Boolean
  version         Int                        @default(1)
  changeReason    String
  updatedByUserId String
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  updatedBy       User                       @relation("PlatformFeatureFlagUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  events          PlatformFeatureFlagEvent[]

  @@index([enabled, updatedAt])
}

model PlatformFeatureFlagEvent {
  id          String              @id @default(cuid())
  flagKey     String
  enabled     Boolean
  version     Int
  reason      String
  actorUserId String
  createdAt   DateTime            @default(now())
  flag        PlatformFeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)
  actor       User                @relation("PlatformFeatureFlagEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([flagKey, createdAt])
  @@index([createdAt])
}

model DestinationContent {
  id              String                    @id @default(cuid())
  slug            String                    @unique
  name            String
  state           String
  country         String                    @default("India")
  summary         String
  introduction    String
  heroImageUrl    String
  bestTimeToVisit String
  highlightsJson  String                    @default("[]")
  travelTipsJson  String                    @default("[]")
  status          String                    @default("DRAFT")
  version         Int                       @default(1)
  changeReason    String
  createdByUserId String
  updatedByUserId String
  publishedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  createdBy       User                      @relation("DestinationContentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy       User                      @relation("DestinationContentUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  events          DestinationContentEvent[]

  @@index([status, updatedAt])
  @@index([state, status, name])
}

model DestinationContentEvent {
  id            String             @id @default(cuid())
  destinationId String
  actorUserId   String
  action        String
  status        String
  version       Int
  reason        String
  createdAt     DateTime           @default(now())
  destination   DestinationContent @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  actor         User               @relation("DestinationContentEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([destinationId, createdAt])
  @@index([createdAt])
}

model PartnerPayoutAccountEvent {
  id              String               @id @default(cuid())
  payoutAccountId String
  actorUserId     String
  action          String
  fromStatus      String
  toStatus        String
  reason          String
  version         Int
  createdAt       DateTime             @default(now())
  payoutAccount   PartnerPayoutAccount @relation(fields: [payoutAccountId], references: [id], onDelete: Cascade)
  actor           User                 @relation("PartnerPayoutAccountEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([payoutAccountId, version])
  @@index([payoutAccountId, createdAt])
  @@index([actorUserId, createdAt])
}

model PartnerTaxProfile {
  id                     String        @id @default(cuid())
  partnerId              String        @unique
  gstRegistrationStatus  String        @default("PENDING")
  gstin                   String        @default("")
  placeOfSupplyStateCode String        @default("")
  section9FiveApplicable Boolean       @default(false)
  section194OExempt      Boolean       @default(false)
  reviewStatus           String        @default("PENDING_REVIEW")
  effectiveFrom          DateTime?
  reviewedAt             DateTime?
  version                Int           @default(1)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  partner                SupplyPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([reviewStatus, gstRegistrationStatus, updatedAt])
}

model ContactInquiry {
  id        String   @id @default(cuid())
  reference String   @unique
  name      String
  email     String
  phone     String   @default("")
  category  String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("ACTIVE")
  source    String   @default("FOOTER")
  consentAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, consentAt])
}
