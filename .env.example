DATABASE_URL="file:./prisma/dev.db"
# Production migrations use a direct TLS PostgreSQL connection supplied by the secret manager.
DIRECT_DATABASE_URL=""
DATABASE_PLATFORM_PROVIDER=""
DATABASE_PLATFORM_REGION=""
DATABASE_HIGH_AVAILABILITY="false"
DATABASE_PITR_ENABLED="false"
DATABASE_BACKUP_POLICY_ID=""
DATABASE_CUTOVER_PLAN_ID=""
DATABASE_RESTORE_EVIDENCE_ID=""
DATABASE_POOL_MAX="10"
DATABASE_CONNECT_TIMEOUT_MS="10000"
DATABASE_STATEMENT_TIMEOUT_MS="30000"
PUBLIC_APP_ORIGIN="http://localhost:3000"
BOOKING_TOKEN_SECRET="replace-with-a-long-random-secret"
MFA_ENCRYPTION_KEY="base64-encoded-32-byte-key"
MEDIA_SIGNING_ENDPOINT="https://storage-signer.example.com/v1/upload-intents"
MEDIA_SIGNING_API_KEY="replace-with-storage-signing-service-key"
MEDIA_PROVIDER_ALLOWED_HOSTS="storage-signer.example.com,uploads.example.com,cdn.example.com"
PAYMENT_GATEWAY_ENDPOINT="https://payments.example.com/v1/checkout-intents"
PAYMENT_GATEWAY_API_KEY="replace-with-payment-gateway-key"
PAYMENT_PROVIDER_ID="configured-gateway"
PAYMENT_PROVIDER_ALLOWED_HOSTS="payments.example.com"
PAYMENT_WEBHOOK_SECRET="replace-with-payment-webhook-secret"
PAYMENT_GATEWAY_REFUND_ENDPOINT="https://payments.example.com/v1/refunds"
PAYMENT_GATEWAY_MODE="sandbox"
# Demo transport checkout is opt-in and is always rejected in production.
ALLOW_DEMO_TRANSPORT_CHECKOUT="false"
# Provider adapters sign short-lived flight, bus, and car payment evidence with this secret.
TRANSPORT_PAYMENT_EVIDENCE_SECRET="replace-with-a-long-random-transport-payment-secret"
# Payout accounts must be tokenized by the payout provider. Never store raw account numbers here.
PAYOUT_PROVIDER_ID="configured-payout-provider"
PAYOUT_PROVIDER_ENDPOINT="https://payouts.example.com/v1/batches"
PAYOUT_PROVIDER_API_KEY="replace-with-payout-provider-key"
PAYOUT_PROVIDER_ALLOWED_HOSTS="payouts.example.com"
EMAIL_PROVIDER_ENDPOINT="https://messaging.example.com/v1/email"
EMAIL_PROVIDER_API_KEY="replace-with-email-provider-key"
EMAIL_PROVIDER_ALLOWED_HOSTS="messaging.example.com"
EMAIL_FROM_ADDRESS="bookings@mandyaltravels.example"
MOBILE_MESSAGING_ENDPOINT="https://messaging.example.com/v1/messages"
MOBILE_MESSAGING_API_KEY="replace-with-sms-whatsapp-provider-key"
MOBILE_MESSAGING_ALLOWED_HOSTS="messaging.example.com"
SMS_SENDER_ID="MANDYL"
WHATSAPP_SENDER="replace-with-approved-whatsapp-sender"
PUSH_PROVIDER_ENDPOINT="https://push.example.com/v1/messages"
PUSH_PROVIDER_API_KEY="replace-with-push-provider-key"
PUSH_PROVIDER_ALLOWED_HOSTS="push.example.com"
NOTIFICATION_WORKER_SECRET="replace-with-at-least-32-random-characters"
NOTIFICATION_WORKER_BATCH_SIZE="25"
NOTIFICATION_WORKER_TIMEOUT_MS="30000"
PARTNER_ADMIN_KEY="replace-with-a-long-random-admin-key"
DATABASE_BACKUP_DIRECTORY="backups"
DATABASE_BACKUP_RETENTION="14"
# Server-to-server partner API calls must also send the supplier's x-partner-id header.
